<odoo>

    <record id="account_move_form_view" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div
                    role="alert"
                    class="alert alert-warning"
                    attrs="{'invisible': [('purchase_mismatch', '=', False)]}"
                >
                    <field name="purchase_mismatch" invisible="1" />
                    <field name="purchase_quantity_mismatch" invisible="1" />
                    <field name="purchase_other_mismatch" invisible="1" />
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <th
                                class="text-danger"
                                attrs="{
                                    'invisible': [
                                        ('purchase_quantity_mismatch', '=', False)
                                    ],
                                }"
                            >
                                Quantity mismatch
                            </th>
                            <th
                                attrs="{
                                    'invisible': [
                                        ('purchase_other_mismatch', '=', False)
                                    ],
                                }"
                            >
                                Price mismatch
                            </th>
                        </tr>
                        <tr>
                            <td
                                class="text-danger"
                                attrs="{
                                    'invisible': [
                                        ('purchase_quantity_mismatch', '=', False)
                                    ],
                                }"
                            >
                                <field name="purchase_quantity_mismatch_summary" />
                            </td>
                            <td
                                attrs="{
                                    'invisible': [
                                        ('purchase_other_mismatch', '=', False)
                                    ],
                                }"
                            >
                                <field name="purchase_other_mismatch_summary" />
                            </td>
                        </tr>
                    </table>
                </div>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']"
                position="after"
            >
                <button
                    name="action_show_purchase_line"
                    type="object"
                    class="fa fa-fw fa-credit-card text-primary"
                    title="Purchase Line"
                    attrs="{'invisible': [('purchase_line_id', '=', False)]}"
                />
                <button
                    name="action_select_purchase_line"
                    type="object"
                    class="fa fa-fw fa-refresh text-primary"
                    title="Select Purchase Line"
                    attrs="{'invisible': [('parent.state', '!=', 'draft')]}"
                />
                <field name="purchase_line_id" invisible="1" />
                <field
                    name="purchase_line_mismatch_summary"
                    string="Alert"
                    widget="badge"
                    readonly="1"
                    optional="show"
                    decoration-danger="purchase_line_quantity_mismatch"
                    decoration-warning="purchase_line_other_mismatch and not purchase_line_quantity_mismatch"
                    attrs="{
                        'column_invisible': [('parent.move_type', '!=', 'in_invoice')],
                    }"
                />
                <button
                    name="action_show_purchase_line_mismatch_details"
                    type="object"
                    class="fa fa-fw fa-info-circle text-info"
                    title="Purchase mismatch details"
                    attrs="{
                        'invisible': [('purchase_line_mismatch', '=', False)],
                        'column_invisible': [('parent.move_type', '!=', 'in_invoice')],
                    }"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree" position="inside">
                <field name="purchase_line_mismatch" invisible="1" />
                <field name="purchase_line_quantity_mismatch" invisible="1" />
                <field name="purchase_line_other_mismatch" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree" position="attributes">
                <attribute
                    name="decoration-danger"
                >purchase_line_quantity_mismatch</attribute>
                <attribute
                    name="decoration-warning"
                >purchase_line_other_mismatch and not purchase_line_quantity_mismatch</attribute>
            </xpath>
        </field>
    </record>



</odoo>
