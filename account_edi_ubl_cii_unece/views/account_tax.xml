<odoo>
    <record id="view_tax_form" model="ir.ui.view">
        <field name="model">account.tax</field>
        <field
            name="inherit_id"
            ref="account_edi_ubl_cii.view_account_invoice_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="ubl_cii_tax_category_code" position="before">
                <field name="unece_type_code" required="1" />
            </field>
            <field name="ubl_cii_tax_category_code" position="attributes">
                <attribute name="invisible">unece_type_code != 'VAT'</attribute>
                <attribute
                    name="required"
                >active and type_tax_use == 'sale' and unece_type_code == 'VAT'</attribute>
            </field>
        </field>
    </record>

    <record id="view_tax_tree" model="ir.ui.view">
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree" />
        <field name="arch" type="xml">
            <field name="tax_scope" position="after">
                <field name="unece_type_code" optional="hide" />
                <field name="ubl_cii_tax_category_code" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_tax_search" model="ir.ui.view">
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_account_tax_search" />
        <field name="arch" type="xml">
            <filter name="domestictax" position="after">
                <separator />
                <filter
                    name="vat"
                    string="VAT"
                    domain="[('unece_type_code', '=', 'VAT')]"
                />
                <filter
                    name="non_vat"
                    string="Other than VAT"
                    domain="[('unece_type_code', '!=', 'VAT')]"
                />
            </filter>
            <filter name="groupfp" position="after">
                <filter
                    name="unece_type_code_groupby"
                    string="UNECE Type"
                    context="{'group_by': 'unece_type_code'}"
                />
                <filter
                    name="ubl_cii_tax_category_code_groupby"
                    string="Tax Category Code"
                    context="{'group_by': 'ubl_cii_tax_category_code'}"
                />
            </filter>
        </field>
    </record>
</odoo>
