#. module: account_edi_ubl_move_line_uom_and_packaging_unece
#: model:ir.model,name:account_edi_ubl_move_line_uom_and_packaging_unece.model_account_move_line
msgid "Journal Item"
msgstr "Movimento contabile"

#. module: account_edi_ubl_move_line_uom_and_packaging_unece
#: model:ir.model.fields,help:account_edi_ubl_move_line_uom_and_packaging_unece.field_account_move_line__ubl_unece_unit_code
msgid ""
"Technical field storing the UNECE unit code from UBL import. Used during "
"purchase reconciliation to identify the corresponding packaging when a "
"purchase order line is manually selected."
msgstr ""
"Campo tecnico che memorizza il codice unità UNECE dall'importazione UBL. "
"Utilizzato durante la riconciliazione degli acquisti per identificare "
"l'imballaggio corrispondente quando una riga dell'ordine di acquisto viene "
"selezionata manualmente."

#. module: account_edi_ubl_move_line_uom_and_packaging_unece
#: model:ir.model.fields,help:account_edi_ubl_move_line_uom_and_packaging_unece.field_account_move_line__ubl_billed_quantity
msgid ""
"Technical field storing the billed quantity from the UBL import. During "
"purchase reconciliation, it allows restoring the original supplier quantity "
"when the quantity has been altered by packaging selection."
msgstr ""
"Campo tecnico in cui è archiviata la quantità fatturata dall'importazione "
"UBL. Durante la riconciliazione degli acquisti, consente di ripristinare la "
"quantità originaria del fornitore quando la quantità è stata modificata "
"dalla selezione dell'imballaggio."

#. module: account_edi_ubl_move_line_uom_and_packaging_unece
#: model:ir.model.fields,help:account_edi_ubl_move_line_uom_and_packaging_unece.field_account_move_line__ubl_price_unit
msgid "Technical field storing the unit price from the UBL import."
msgstr "Campo tecnico che memorizza il prezzo unitario dall'importazione UBL."

