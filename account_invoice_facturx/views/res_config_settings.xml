<odoo>


<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">account_invoice_factur-x.res.config.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account_e-invoice_generate.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@class='content-group']" position="replace">
            <div name="facturx_settings">
            <label for="id" string="Factur-X Invoices"/>
            <div name="facturx">
                <div name="facturx_level">
                    <label for="facturx_level" />
                    <field name="facturx_level" class="oe_inline" attrs="{'required': [('xml_format_in_pdf_invoice', '=', 'factur-x')]}"/>
                </div>
                <div name="facturx_refund_type">
                    <label for="facturx_refund_type" />
                    <field name="facturx_refund_type" class="oe_inline" attrs="{'required': [('xml_format_in_pdf_invoice', '=', 'factur-x')]}"/>
                </div>
            </div>
            </div>
        </xpath>
    </field>
</record>


</odoo>