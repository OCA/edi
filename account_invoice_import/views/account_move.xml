<odoo>


<record id="view_move_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
        <div role="alert" position="after">
            <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('show_import_warnings', '=', False)]}"
                >
                <field name="import_warnings" />
            </div>
        </div>
        <field name="show_name_warning" position="after">
            <field name="show_import_warnings" invisible="1" />
            <field name="import_partner_data" invisible="1" />
        </field>
        <field name="partner_id" position="after">
                <button
                    name="%(account_invoice_import_partner_create_action)d"
                    type="action"
                    attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'draft'), ('move_type', 'not in', ('in_invoice', 'in_refund')), ('import_partner_data', '=', False), ('partner_id', '!=', False)]}"
                    groups="account.group_account_invoice"
                    colspan="2"
                    string="Create or Update Partner"
                />
        </field>
        <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='sequence']"
                position="after"
            >
            <field
                name="import_invoice_line_identifier"
                string="Ext. ID"
                attrs="{'column_invisible': [('parent.move_type', 'not in', ('in_invoice', 'in_refund'))]}"
                optional="show"
                />
        </xpath>
        <xpath
            expr="//field[@name='invoice_line_ids']/form/sheet//field[@name='product_id']"
            position="before"
            >
            <field
                name="import_invoice_line_identifier"
                string="External ID"
                attrs="{'invisible': ['|', ('display_type', '!=', 'product'), ('parent.move_type', 'not in', ('in_invoice', 'in_refund'))]}"
                />
        </xpath>
        <group name="accounting_info_group" position="inside">
            <field
                name="import_check_total"
                attrs="{'invisible': ['|', '|', ('imported', '=', False), ('state', '!=', 'draft'), ('move_type', 'not in', ('in_invoice', 'in_refund'))]}"
            />
            <field name="imported" invisible="1" />
        </group>
    </field>
</record>


</odoo>
