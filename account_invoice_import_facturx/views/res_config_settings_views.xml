<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.account_invoice_import_facturx</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='autopost_bills']" position="after">
                <setting
                    id="invoice_import_facturx_allowance_separate_line"
                    help="This field allows you create allowances or charges as separate lines when importing FacturX invoices"
                >
                    <field name="invoice_import_facturx_allowance_separate_line" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
