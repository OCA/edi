#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"<p>Odoo couldn't find any unit of measure corresponding to the following "
"information extracted from the business document:</p><ul><li>UNECE code: "
"%(code)s</li><li>Name of the unit of measure: %(name)s</li></ul><p>So the "
"unit of measure 'Unit(s)' has been used. <em>You may have to change it "
"manually.</em></p>"
msgstr ""
"<p>Es konnte keine Maßeinheit gefunden werden, die den folgenden, aus dem "
"Geschäftsbeleg extrahierten Informationen entspricht:</p><ul><li>UNECE-Code: "
"%(code)s</li><li>Bezeichnung der Maßeinheit: %(name)s</li></ul><p>Daher "
"wurde die Maßeinheit „Stück“ verwendet. <em>Möglicherweise müssen Sie diese "
"manuell ändern.</em></p>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Approximate match: account %(account)s has been matched with account "
"%(matched_account)s"
msgstr ""
"Ungefähre Übereinstimmung: Das Konto %(account) wurde mit dem Konto %"
"(matched_account) abgeglichen"

#. module: base_business_document_import
#: model:ir.model,name:base_business_document_import.model_business_document_import
msgid "Common methods to import business documents"
msgstr "Gängige Methoden zum Importieren von Geschäftsdokumenten"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "Could not find any Incoterm in Odoo corresponding to '%s'"
msgstr "Es konnte kein Incoterm gefunden werden, der „%s“ entspricht."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"For product '%(product)s', the unit of measure is %(uom_product)s on the "
"existing line, but it is %(uom_imported)s on the imported line.We don't "
"support this scenario for the moment, so <b>the lines haven't been "
"updated</b>."
msgstr ""
"Für das Produkt „%(product)s“ lautet die Maßeinheit in der bestehenden Zeile "
"„%(uom_product)s“, in der importierten Zeile jedoch „%(uom_imported)s“. Da "
"wir dieses Szenario derzeit nicht unterstützen, <b>wurden die Zeilen nicht "
"aktualisiert</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "IBAN <b>%s</b> is not valid, so it has been ignored."
msgstr "Die IBAN <b>%s</b> ist ungültig und wurde daher ignoriert."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "ID {id} of '{model}' doesn't exist in Odoo."
msgstr "Die ID {id} von „{model}“ existiert nicht."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "Missing VAT number on company '%s'"
msgstr "Fehlende Umsatzsteuer-Identifikationsnummer bei der Firma „%s“"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "No currency specified, so Odoo used the company currency (%s)"
msgstr ""
"Es wurde keine Währung angegeben, daher wird die Unternehmenswährung (%s) "
"verwendet"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any %(label)s corresponding to the following information extracted from the business document:\n"
"Name: %(name)s \n"
"VAT number: %(vat)s \n"
"Reference: %(ref)s \n"
"E-mail: %(email)s \n"
"Website: %(website)s \n"
"State code: %(state)s \n"
"Country code: %(country)s \n"
msgstr ""
"Es konnten keine %(label)s finden, die den folgenden aus dem Geschäftsbeleg "
"extrahierten Informationen entsprechen: \n"
"Name: %(name)s\n"
"Umsatzsteuer-Identifikationsnummer: %(vat)s\n"
"Referenz: %(ref)s\n"
"E-Mail: %(email)s \n"
"Website: %(website)s \n"
"Bundesland: %(state)s \n"
"Ländercode: %(country)s \n"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any account corresponding to the following information extracted from the business document:\n"
"Account code: %s"
msgstr ""
"Es konnte kein Konto gefunden werden, das den folgenden, aus dem "
"Geschäftsbeleg extrahierten Informationen entspricht:\n"
"Kontocode: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any analytic account corresponding to the following information extracted from the business document:\n"
"Analytic account code: %s"
msgstr ""
"Es konnte kein analytisches Konto gefunden werden, das den folgenden, aus "
"dem Geschäftsbeleg extrahierten Informationen entspricht:\n"
"Code des analytischen Kontos: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any journal corresponding to the following information extracted from the business document:\n"
"Journal code: %s"
msgstr ""
"Es konnte kein Buchungssatz gefunden werden, der den folgenden, aus dem "
"Geschäftsbeleg extrahierten Informationen entspricht:\n"
"Buchungscode: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any product corresponding to the following information extracted from the business document:\n"
"Barcode: %(barcode)s\n"
"Product code: %(product_code)s\n"
"Supplier: %(supplier)s\n"
msgstr ""
"Es konnte kein Produkt gefunden werden, das den folgenden, aus dem "
"Geschäftsbeleg extrahierten Informationen entspricht:\n"
"Barcode: %(barcode)s\n"
"Produktcode: %(product_code)s\n"
"Lieferant: %(supplier)s\n"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any shipping partner corresponding to the following information extracted from the business document:\n"
"Name: %(name)s\n"
"VAT number: %(vat)s\n"
"Reference: %(ref)s\n"
"E-mail: %(email)s\n"
"Website: %(website)s\n"
"Street: %(street)s\n"
"Street2: %(street2)s\n"
"City: %(city)s\n"
"ZIP: %(zip)s\n"
"State code: %(state)s\n"
"Country code: %(country)s\n"
msgstr ""
"Es konnte kein Versandpartner gefunden werden, der den folgenden, aus dem "
"Geschäftsbeleg extrahierten Informationen entspricht:\n"
"Name: %(name)s\n"
"Umsatzsteuer-Identifikationsnummer: %(vat)s\n"
"Referenz: %(ref)s\n"
"E-Mail: %(email)s\n"
"Website: %(website)s\n"
"Straße: %(street)s\n"
"Straße 2: %(street2)s\n"
"Ort: %(city)s\n"
"Postleitzahl: %(zip)s\n"
"Bundesland: %(state)s\n"
"Ländercode: %(country)s\n"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"Odoo couldn't find any tax with 'Tax Application' = '%(tax)s' and 'Tax Included in Price' = '%(price)s' which correspond to the following information extracted from the business document:\n"
"UNECE Tax Type code: %(tax_type)s\n"
"UNECE Tax Category code: %(tax_cat)s\n"
"UNECE Due Date code: %(tax_due_date)s\n"
"Tax amount: %(amount)s %(amount_type)s"
msgstr ""
"Es konnte keine Steuer mit „Steueranwendung“ = „%(tax)s“ und „Steuer im "
"Preis enthalten“ = „%(price)s“ gefunden werden, die den folgenden aus dem "
"Geschäftsbeleg extrahierten Informationen entsprechen:\n"
"UNECE-Steuertyp-Code: %(tax_type)s\n"
"UNECE-Steuerkategoriecode: %(tax_cat)s\n"
"UNECE-Fälligkeitsdatumcode: %(tax_due_date)s\n"
"Steuerbetrag: %(amount)s %(amount_type)s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"One of the imported lines doesn't have any product, so <b>the lines haven't "
"been updated</b>."
msgstr ""
"Eine der importierten Zeilen enthält kein Produkt, daher <b>wurden die "
"Zeilen nicht aktualisiert</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The %(label)s has been identified by the domain name '%(domain)s' so please "
"check carefully that the %(label)s is correct."
msgstr ""
"%(label)s wurde anhand des Domainnamens '%(domain)s' identifiziert. Bitte "
"überprüfen Sie daher sorgfältig, ob %(label)s korrekt ist."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The VAT number of the customer written in the business document "
"(%(parsed_vat)s) doesn't match the VAT number of the company '%(company)s' "
"(%(vat)s) in which you are trying to import this document."
msgstr ""
"Die im Geschäftsbeleg angegebene Umsatzsteuer-Identifikationsnummer des "
"Kunden (%(parsed_vat)s) stimmt nicht mit der Umsatzsteuer-"
"Identifikationsnummer des Unternehmens „%(company)s“ (%(vat)s) überein, in "
"das Sie diesen Beleg importieren möchten."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid "The XMLID '%s' doesn't exist in Odoo."
msgstr "Die XML-ID „%s“ existiert nicht."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%(code)s' as the country "
"code to find the related currency. But the country '%(name)s' doesn't have "
"any related currency configured in Odoo."
msgstr ""
"Bei der Analyse des Geschäftsbelegs wurde „%(code)s“ als Ländercode "
"zurückgegeben, um die zugehörige Währung zu ermitteln. Für das Land „%(name)s"
"“ ist jedoch keine zugehörige Währung konfiguriert."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%(code)s' as the currency "
"symbol or ISO code. But there are none or several currencies with the "
"symbol/ISO code in Odoo."
msgstr ""
"Die Analyse des Geschäftsdokuments ergab „%(code)s“ als Währungssymbol oder "
"ISO-Code. Es gibt jedoch keine oder mehrere Währungen mit diesem Symbol bzw. "
"ISO-Code."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%(code)s' as the unit of "
"measure UNECE code, but there is no unit of measure with that UNECE code in "
"Odoo. Please check the configuration of the units of measures in Odoo."
msgstr ""
"Die Analyse des Geschäftsbelegs ergab „%(code)s“ als UNECE-Code für die "
"Maßeinheit, doch es gibt keine Maßeinheit mit diesem UNECE-Code. Bitte "
"überprüfen Sie die Konfiguration der Maßeinheiten."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%s' as country code. But "
"there are no country with that code in Odoo."
msgstr ""
"Bei der Analyse des Geschäftsdokuments wurde „%s“ als Ländercode "
"zurückgegeben. Es gibt jedoch kein Land mit diesem Code."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%s' as the country code to "
"find the related currency. But there is no country with that code in Odoo."
msgstr ""
"Bei der Analyse des Geschäftsdokuments wurde „%s“ als Ländercode "
"zurückgegeben, um die zugehörige Währung zu ermitteln. Es gibt jedoch kein "
"Land mit diesem Code."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%s' as the currency ISO "
"code. But there are no currency with that code in Odoo."
msgstr ""
"Die Analyse des Geschäftsdokuments ergab „%s“ als ISO-Währungscode. Es gibt "
"jedoch keine Währung mit diesem Code."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned '%s' as the currency symbol. "
"But there are none or several currencies with that symbol in Odoo."
msgstr ""
"Die Analyse des Geschäftsdokuments ergab „%s“ als Währungssymbol. Es gibt "
"jedoch keine oder mehrere Währungen mit diesem Symbol."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The analysis of the business document returned <b>IBAN %(iban)s</b> as bank "
"account, but there is no such bank account in Odoo linked to partner <a "
"href=# data-oe-model=res.partner data-oe-id=%(partner_id)d>%(partner)s</a> "
"and the option to automatically create bank accounts upon import is "
"disabled."
msgstr ""
"Die Analyse des Geschäftsdokuments ergab <b>IBAN %(iban)s</b> als Bankkonto, "
"es gibt kein solches Bankkonto, das mit dem Partner <a href=# data-oe-"
"model=res.partner data-oe-id=%(partner_id)d>%(partner)s</a> verknüpft ist, "
"und die Option zum automatischen Anlegen von Bankkonten beim Import ist "
"deaktiviert."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
#, python-format
msgid ""
"The bank account <b>IBAN %(iban)s</b> has been automatically added on the "
"supplier <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)d>%(partner)s</a>"
msgstr ""
"Das Bankkonto <b>IBAN %(iban)s</b> wurde automatisch zum Lieferanten <a "
"href=# data-oe-model=res.partner data-oe-id=%(partner_id)d>%(partner)s</a> "
"hinzugefügt"

#. module: base_business_document_import
