<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_groups_privilege_edi" model="res.groups.privilege">
        <field name="name">EDI</field>
        <field name="sequence" eval="10" />
        <field name="category_id" ref="module_category_edi" />
    </record>

    <record id="group_edi_user" model="res.groups">
        <field name="name">EDI User</field>
        <field name="privilege_id" ref="res_groups_privilege_edi" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_edi_manager" model="res.groups">
        <field name="name">EDI Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_edi" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
        <field
            name="implied_ids"
            eval="[Command.link(ref('base_edi.group_edi_user'))]"
        />
    </record>
</odoo>
