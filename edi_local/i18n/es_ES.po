#. module: edi_local
#: model:ir.model.fields,help:edi_local.field_edi_local_line__type_data
msgid ""
"Defines the data type of the value\n"
"Alphanumeric: Only letters and numbers are allowed. Example: Alpha12pha345\n"
"Numeric: Only numbers are allowed. Example: 12345\n"
"Date: Only dates are allowed. Example: 20251112\n"
"General: Any value is allowed. Example: Alpha1_2pha345-*_"
msgstr ""
"Define el tipo de dato del valor\n"
"Alfanumérico: solo se permiten letras y números. Ejemplo: Alpha12pha345\n"
"Numérico: solo se permiten números. Ejemplo: 12345\n"
"Fecha: solo se permiten fechas. Ejemplo: 20251112\n"
"General: se permite cualquier valor. Ejemplo: Alpha1_2pha345-*_"

#. module: edi_local
