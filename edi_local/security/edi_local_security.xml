<odoo noupdate="0">

    <record model="ir.module.category" id="module_category_edi_local">
            <field name="name">Edi Local</field>
            <field name="sequence">100</field>
        </record>

    <record id="group_user_edi_local" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_edi_local" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_admin_edi_local" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_edi_local" />
        <field name="implied_ids" eval="[(4, ref('group_user_edi_local'))]" />
    </record>
</odoo>
