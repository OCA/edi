<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="edi_local_header_view_tree" model="ir.ui.view">
        <field name="name">edi.local.header.view.tree</field>
        <field name="model">edi.local.header</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="edi_local_header_tree_action" model="ir.actions.act_window">
        <field name="name">Edi local header</field>
        <field name="res_model">edi.local.header</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="edi_local.edi_local_header_view_tree" />
    </record>

</odoo>
