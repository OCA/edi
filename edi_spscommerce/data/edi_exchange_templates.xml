<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- QWeb views for RSX outbound documents. Structure and the RSX ->
         Odoo domain mapping live here in data: templates consume the
         business record directly (``record`` is the related picking/move,
         provided by the framework's render context), so a partner profile
         can override the template on its own exchange type
         (output_template_id) without code changes. The handler injects
         ``meta`` (envelope ids); ``exchange_record`` and ``backend`` are
         also in context if a template needs them. -->

    <!-- Shared group fragments (t-called by the document templates) -->

    <record id="qweb_sps_meta" model="ir.ui.view">
        <field name="key">edi_spscommerce.sps_meta</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="edi_spscommerce.sps_meta">
                <!-- SPS envelope ids, injected by the handler from the
                     exchange type's rsx.* settings. -->
                <Meta>
                    <SenderUniqueID t-if="meta.get('sender_unique_id')" t-esc="meta.get('sender_unique_id')" />
                    <ReceiverUniqueID t-if="meta.get('receiver_unique_id')" t-esc="meta.get('receiver_unique_id')" />
                    <InterchangeSenderID t-if="meta.get('interchange_sender_id')" t-esc="meta.get('interchange_sender_id')" />
                    <InterchangeReceiverID t-if="meta.get('interchange_receiver_id')" t-esc="meta.get('interchange_receiver_id')" />
                </Meta>
            </t>
        </field>
    </record>

    <record id="qweb_sps_address" model="ir.ui.view">
        <field name="key">edi_spscommerce.sps_address</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="edi_spscommerce.sps_address">
                <!-- Renders <Address> from a res.partner recordset.
                     Context vars: ``partner`` (res.partner) and
                     ``type_code`` (RSX AddressTypeCode: ST ship-to,
                     BT bill-to, SF ship-from, BY buying party...). -->
                <Address>
                    <AddressTypeCode t-esc="type_code" />
                    <!-- AddressLocationNumber is the partner's GLN/DUNS
                         location id; today it falls back to the partner
                         Internal Reference until a dedicated location
                         field lands (see design doc: x_sps_location). -->
                    <AddressLocationNumber t-if="partner.ref" t-esc="partner.ref" />
                    <AddressName t-esc="partner.name" />
                    <Address1 t-if="partner.street" t-esc="partner.street" />
                    <Address2 t-if="partner.street2" t-esc="partner.street2" />
                    <City t-if="partner.city" t-esc="partner.city" />
                    <State t-if="partner.state_id" t-esc="partner.state_id.code" />
                    <PostalCode t-if="partner.zip" t-esc="partner.zip" />
                    <Country t-if="partner.country_id" t-esc="partner.country_id.code" />
                </Address>
            </t>
        </field>
    </record>

    <record id="qweb_sps_item_ids" model="ir.ui.view">
        <field name="key">edi_spscommerce.sps_item_ids</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="edi_spscommerce.sps_item_ids">
                <!-- Part-number identification block. Context vars:
                     ``product`` (product.product) and ``partner``
                     (res.partner the codes belong to).
                     VendorPartNumber/ApplicationId carry OUR sku
                     (default_code); BuyerPartNumber carries the
                     customer's code; GTIN carries the barcode. -->
                <ApplicationId t-if="product.default_code" t-esc="product.default_code" />
                <VendorPartNumber t-if="product.default_code" t-esc="product.default_code" />
                <!-- product.customer.code is an optional OCA module; the
                     registry guard keeps the template valid when it is
                     not installed. -->
                <t t-if="partner and record.env.registry.get('product.customer.code')">
                    <t t-set="cust_code" t-value="record.env['product.customer.code'].search([('partner_id', '=', partner.id), ('product_id', '=', product.id)], limit=1)" />
                    <BuyerPartNumber t-if="cust_code" t-esc="cust_code.product_code" />
                </t>
                <GTIN t-if="product.barcode" t-esc="product.barcode" />
            </t>
        </field>
    </record>

    <!-- Document templates. ``record`` is the related Odoo record. -->

    <record id="qweb_sps_shipments" model="ir.ui.view">
        <field name="key">edi_spscommerce.sps_shipments</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="edi_spscommerce.sps_shipments">
                <!-- record: stock.picking -->
                <Shipments xmlns="http://www.spscommerce.com/RSX">
                    <Shipment>
                        <t t-call="edi_spscommerce.sps_meta" />
                        <Header>
                            <ShipmentHeader>
                                <!-- The partner's SPS trading-partner id is
                                     kept in Internal Reference (ref); the
                                     schema caps it at 15 chars, so no
                                     name fallback. -->
                                <TradingPartnerId t-if="record.partner_id.ref" t-esc="record.partner_id.ref" />
                                <ShipmentIdentification t-esc="record.name" />
                                <!-- date_done is a datetime; RSX splits it
                                     into xs:date + xs:time elements. -->
                                <ShipDate t-if="record.date_done" t-esc="record.date_done.strftime('%Y-%m-%d')" />
                                <ShipmentTime t-if="record.date_done" t-esc="record.date_done.strftime('%H:%M:%S')" />
                            </ShipmentHeader>
                            <!-- picking.partner_id is the delivery address
                                 (ST). Ship-from (SF) would be the
                                 warehouse partner — TODO if the partner
                                 guide requires it. -->
                            <t t-set="partner" t-value="record.partner_id" />
                            <t t-set="type_code" t-value="'ST'" />
                            <t t-call="edi_spscommerce.sps_address" />
                        </Header>
                        <OrderLevel>
                            <OrderHeader>
                                <!-- The PO this ASN answers is the
                                     customer's order ref on the SO that
                                     generated the picking; our own order
                                     number falls back to picking.origin. -->
                                <PurchaseOrderNumber t-if="record.sale_id.client_order_ref" t-esc="record.sale_id.client_order_ref" />
                                <InternalOrderNumber t-esc="record.sale_id.name or record.origin" />
                            </OrderHeader>
                            <!-- One ShipmentLine per stock.move.
                                 LineSequenceNumber is 1-based. -->
                            <t t-foreach="record.move_ids" t-as="line">
                                <ItemLevel>
                                    <ShipmentLine>
                                        <LineSequenceNumber t-esc="line_index + 1" />
                                        <t t-set="product" t-value="line.product_id" />
                                        <!-- Buyer codes belong to the
                                             sold-to partner, not the
                                             delivery contact — they differ
                                             on dropship orders. -->
                                        <t t-set="partner" t-value="record.sale_id.partner_id or record.partner_id" />
                                        <t t-call="edi_spscommerce.sps_item_ids" />
                                        <!-- TODO: product_uom.name is not
                                             an X12 355 code — needs the
                                             UOM map from the design doc. -->
                                        <ShipQty t-esc="line.quantity" />
                                        <ShipQtyUOM t-esc="line.product_uom.name" />
                                        <OrderQty t-esc="line.product_uom_qty" />
                                    </ShipmentLine>
                                </ItemLevel>
                            </t>
                        </OrderLevel>
                        <Summary>
                            <TotalOrders t-esc="1 if record.sale_id else 0" />
                            <TotalLineItemNumber t-esc="len(record.move_ids)" />
                        </Summary>
                    </Shipment>
                </Shipments>
            </t>
        </field>
    </record>

    <record id="qweb_sps_invoices" model="ir.ui.view">
        <field name="key">edi_spscommerce.sps_invoices</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="edi_spscommerce.sps_invoices">
                <!-- record: account.move -->
                <Invoices xmlns="http://www.spscommerce.com/RSX">
                    <Invoice>
                        <t t-call="edi_spscommerce.sps_meta" />
                        <Header>
                            <InvoiceHeader>
                                <!-- Same 15-char schema cap — ref only. -->
                                <TradingPartnerId t-if="record.partner_id.ref" t-esc="record.partner_id.ref" />
                                <InvoiceNumber t-esc="record.name" />
                                <InvoiceDate t-if="record.invoice_date" t-esc="record.invoice_date.strftime('%Y-%m-%d')" />
                                <!-- The customer PO lives on the SO linked
                                     through the invoice lines
                                     (invoice_line_ids.sale_line_ids). -->
                                <t t-set="order" t-value="record.invoice_line_ids.sale_line_ids.order_id[:1]" />
                                <PurchaseOrderNumber t-if="order.client_order_ref" t-esc="order.client_order_ref" />
                                <InternalOrderNumber t-if="record.invoice_origin" t-esc="record.invoice_origin" />
                                <!-- X12 BIG codes: DI = debit invoice,
                                     CR = credit memo. -->
                                <InvoiceTypeCode t-esc="'DI' if record.move_type == 'out_invoice' else 'CR'" />
                                <!-- We invoice in our currency. -->
                                <SellersCurrency t-esc="record.currency_id.name" />
                            </InvoiceHeader>
                            <!-- TODO: full terms block (TermsType, discount
                                 fields) needs the per-partner payment-term
                                 mapping — see design doc. -->
                            <PaymentTerms t-if="record.invoice_date_due">
                                <TermsNetDueDate t-esc="record.invoice_date_due.strftime('%Y-%m-%d')" />
                            </PaymentTerms>
                            <t t-set="partner" t-value="record.partner_id" />
                            <t t-set="type_code" t-value="'BT'" />
                            <t t-call="edi_spscommerce.sps_address" />
                            <t t-set="partner" t-value="record.partner_shipping_id" />
                            <t t-set="type_code" t-value="'ST'" />
                            <t t-call="edi_spscommerce.sps_address" />
                        </Header>
                        <t t-foreach="record.invoice_line_ids" t-as="line">
                            <!-- Only real product lines are billed items;
                                 section/note lines are skipped. The
                                 sequence keeps the display order. -->
                            <t t-if="line.display_type == 'product'">
                                <LineItem>
                                    <InvoiceLine>
                                        <LineSequenceNumber t-esc="line.sequence" />
                                        <t t-set="product" t-value="line.product_id" />
                                        <t t-set="partner" t-value="record.partner_id" />
                                        <t t-call="edi_spscommerce.sps_item_ids" />
                                        <InvoiceQty t-esc="line.quantity" />
                                        <InvoiceQtyUOM t-esc="line.product_uom_id.name" />
                                        <PurchasePrice t-esc="line.price_unit" />
                                        <ExtendedItemTotal t-esc="line.price_subtotal" />
                                    </InvoiceLine>
                                </LineItem>
                            </t>
                        </t>
                        <Summary>
                            <TotalAmount t-esc="record.amount_total" />
                            <TotalSalesAmount t-esc="record.amount_untaxed" />
                            <TotalTaxesAndCharges t-esc="record.amount_tax" />
                            <!-- product_id is only set on real lines, so
                                 this counts the InvoiceLines emitted. -->
                            <TotalLineItemNumber t-esc="len(record.invoice_line_ids.product_id)" />
                        </Summary>
                    </Invoice>
                </Invoices>
            </t>
        </field>
    </record>

    <!-- Output template records bound to the outbound exchange types -->

    <record id="sps_template_shipments" model="edi.exchange.template.output">
        <field name="name">SPS RSX Shipments</field>
        <field name="code">sps_shipments</field>
        <field name="backend_type_id" ref="edi_backend_type_sps" />
        <field name="generator">qweb</field>
        <field name="output_type">xml</field>
        <field name="prettify" eval="True" />
        <field name="template_id" ref="qweb_sps_shipments" />
    </record>

    <record id="sps_template_invoices" model="edi.exchange.template.output">
        <field name="name">SPS RSX Invoices</field>
        <field name="code">sps_invoices</field>
        <field name="backend_type_id" ref="edi_backend_type_sps" />
        <field name="generator">qweb</field>
        <field name="output_type">xml</field>
        <field name="prettify" eval="True" />
        <field name="template_id" ref="qweb_sps_invoices" />
    </record>
</odoo>
