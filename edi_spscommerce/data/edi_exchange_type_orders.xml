<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Handler model reference: ir.model xmlid for edi.sps.handler -->

    <record id="sps_type_orders_in" model="edi.exchange.type">
        <field name="name">SPS RSX Orders Inbound</field>
        <field name="code">sps_orders_in</field>
        <field name="direction">input</field>
        <field name="backend_id" ref="edi_backend_sps" />
        <field name="backend_type_id" ref="edi_backend_type_sps" />
        <field name="receive_model_id" ref="model_edi_sps_handler" />
        <field name="process_model_id" ref="model_edi_sps_handler" />
        <field name="input_validate_model_id" ref="model_edi_sps_handler" />
        <!-- SPS convention: inbound files carry a doc-type prefix ("PO" for
             purchase orders). Confirm the RSX naming convention with the
             SPS integration team — see readme/ROADMAP.md. -->
        <field name="exchange_filename_pattern">^PO</field>
        <field name="advanced_settings_edit"><![CDATA[
rsx:
  document: "orders"
  xsd_validate: false
]]></field>
    </record>
</odoo>
