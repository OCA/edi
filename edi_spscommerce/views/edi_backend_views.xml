<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edi_backend_view_form" model="ir.ui.view">
        <field name="model">edi.backend</field>
        <field name="inherit_id" ref="edi_storage_oca.edi_backend_view_form" />
        <field name="arch" type="xml">
            <!-- On sps backends the pending dirs come from the sps_*
                 fields (live + test per test_mode), so the generic
                 pending-dir fields are hidden and the SPS ones shown. -->
            <field name="input_dir_pending" position="attributes">
                <attribute name="invisible">backend_type_code == 'sps'</attribute>
            </field>
            <field name="output_dir_pending" position="attributes">
                <attribute name="invisible">backend_type_code == 'sps'</attribute>
            </field>
            <field name="input_dir_pending" position="before">
                <field
                    name="sps_input_dir_pending"
                    invisible="backend_type_code != 'sps'"
                />
                <field
                    name="sps_test_input_dir_pending"
                    invisible="backend_type_code != 'sps'"
                />
            </field>
            <field name="output_dir_pending" position="before">
                <field
                    name="sps_output_dir_pending"
                    invisible="backend_type_code != 'sps'"
                />
                <field
                    name="sps_test_output_dir_pending"
                    invisible="backend_type_code != 'sps'"
                />
            </field>
        </field>
    </record>
</odoo>
