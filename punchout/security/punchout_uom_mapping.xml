<odoo>
    <record model="ir.model.access" id="punchout_uom_mapping_access_user">
        <field name="name">punchout.uom.mapping access user</field>
        <field name="model_id" ref="punchout.model_punchout_uom_mapping" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
