<odoo>
    <!--FORM view-->
    <record model="ir.ui.view" id="punchout_backend_form_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="redirect_to_backend"
                        type="object"
                        icon="fa-sign-in"
                        string="Access"
                    />
                    <field name="state" widget="statusbar" options="{'clickable': 1}" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_sessions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                        >
                            <field
                                name="session_count"
                                widget="statinfo"
                                string="Sessions"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label
                            for="name"
                            string="PunchOut Backend"
                            class="oe_read_only"
                        />
                        <label for="name" class="oe_edit_only" />
                        <h1 class="oe_title">
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="group_main">
                        <group>
                            <field name="description" />
                            <field name="protocol" />
                            <field name="url" />
                            <field name="browser_form_post_url" />
                        </group>
                        <group>
                            <field name="session_duration" />
                            <field name="session_retention_days" />
                            <field name="max_response_size" />
                        </group>
                    </group>
                    <notebook>
                        <page string="UoM Mappings" name="uom_mappings">
                            <field
                                name="uom_mapping_ids"
                                context="{'default_backend_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="supplier_code" />
                                    <field name="uom_id" />
                                    <field name="notes" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <!--TREE view-->
    <record model="ir.ui.view" id="punchout_backend_tree_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <field name="url" />
                <field name="state" />
            </list>
        </field>
    </record>
    <!--SEARCH view-->
    <record model="ir.ui.view" id="punchout_backend_search_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="url" />
                <field name="protocol" />
                <group string="Group By" name="groupby">
                    <filter
                        name="group_by_protocol"
                        string="Protocol"
                        context="{'group_by': 'protocol'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="punchout_backend_kanban_view">
        <field name="model">punchout.backend</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="description" />
                <field name="protocol" />
                <templates>
                    <t t-name="card">
                        <div
                            class="oe_kanban_vignette"
                            style="padding: 5px 5px 5px 5px;"
                        >
                            <h2>
                                <field name="description" />
                            </h2>
                            <div class="oe_kanban_details">
                                <span class="badge bg-info">
                                    <field name="protocol" />
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left" />
                                <div class="oe_kanban_bottom_right">
                                    <button
                                        name="redirect_to_backend"
                                        type="object"
                                        class="btn btn-primary"
                                    >
                                        <i class="fa fa-sign-in" /> Access
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--ACTION-->
    <record model="ir.actions.act_window" id="punchout_backend_act_window">
        <field name="name">Punchout Backends</field>
        <field name="res_model">punchout.backend</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <!--MENUS-->
    <record model="ir.ui.menu" id="punchout_menu">
        <field name="name">PunchOut</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="sequence" eval="150" />
    </record>
    <record model="ir.ui.menu" id="punchout_backend_menu">
        <field name="name">PunchOut Backends</field>
        <field name="parent_id" ref="punchout.punchout_menu" />
        <field name="action" ref="punchout.punchout_backend_act_window" />
        <field name="sequence" eval="10" />
    </record>
</odoo>
