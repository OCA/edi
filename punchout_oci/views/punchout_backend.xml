<odoo>
    <record model="ir.ui.view" id="punchout_backend_form_view_oci">
        <field name="name">punchout.backend.form.oci</field>
        <field name="model">punchout.backend</field>
        <field name="inherit_id" ref="punchout.punchout_backend_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_main']" position="after">
                <group
                    name="group_oci_settings"
                    string="OCI Settings"
                    invisible="protocol != 'oci'"
                >
                    <group>
                        <field name="oci_version" />
                        <field name="oci_custom_parameters" password="True" />
                    </group>
                    <group />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
